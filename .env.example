# Required: OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: Override default OpenAI models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Konveksi Business Configuration (Optional)
NEXT_PUBLIC_KONVEKSI_NAME="Ken Konveksi"
NEXT_PUBLIC_KONVEKSI_CITY="Bandung & Jabodetabek"
# Nomor WhatsApp Admin Konveksi (format 628xxx tanpa + atau spasi)
KONVEKSI_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_KONVEKSI_WA=6281234567890

# Pinecone Vector Database (https://app.pinecone.io)
# Create a Serverless index with dimension=1536 (for text-embedding-3-small) and metric=cosine
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=rag-docs
# Optional: supply host directly to skip describeIndex lookup
# PINECONE_HOST=
